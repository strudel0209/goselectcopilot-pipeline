{
  "name": "GoSelect Copilot - Document Segmentation Lab",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  // Microsoft is moving off direct public registries. PyPI's wheel CDN
  // (files.pythonhosted.org) is not routable here; the CFS proxy is.
  "containerEnv": {
    "PIP_INDEX_URL": "https://packagefeedproxy.microsoft.io/pypi/simple/",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  // The image ships its own pipx pytest earlier on PATH, in an environment that
  // cannot see this project. Without this, bare `pytest` fails on imports.
  "remoteEnv": {
    "PATH": "${containerEnv:HOME}/.local/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-azureresourcegroups"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3"
      }
    }
  },
  // --user because site-packages belongs to root and this container does not.
  // Never a venv: the workspace is a 9p bind mount and writing an environment
  // across it takes minutes rather than seconds.
  "postCreateCommand": "pip install --user -e .[dev]"
}
