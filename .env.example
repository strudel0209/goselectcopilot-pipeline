# Copy to .env and fill in. .env is gitignored.
#
# Every producer reads its configuration from here. The CLI calls load_dotenv()
# before dispatching, so commands pick these up automatically when run from the
# repo root.

# --- Azure AI Content Understanding (producer: content-understanding) --------
# Auth is Entra ID only; the key below is unused by the client.
# Run `goselect-docproc setup-analyzer` once before first use.
CONTENTUNDERSTANDING_ENDPOINT=https://<resource>.services.ai.azure.com/
CONTENTUNDERSTANDING_API_KEY=
CU_ANALYZER_ID=goselectRouterV3

# --- Model layer (extraction) ------------------------------------------------
# Foundry deployment used for chat completions. Falls back to the Content
# Understanding endpoint when blank, because both live on the same AI Services
# resource. Leave the key blank to use DefaultAzureCredential.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Deployments used by eval/report.py. Measured on the Howey package: the mini is
# equal to the flagship on specification prose and fabricated tags on drawings,
# so the two paths are deliberately different deployments.
REPORT_MODEL=gpt-5.4-mini
REPORT_DRAWING_MODEL=gpt-5.6-sol
