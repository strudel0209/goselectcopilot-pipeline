# Copy to .env and fill in. .env is gitignored.
#
# Every producer reads its configuration from here. The CLI calls load_dotenv()
# before dispatching, so commands pick these up automatically when run from the
# repo root.

# --- Azure AI Document Intelligence (producers: di-layout, hybrid-cu-di) ------
# Required for the baseline. Leave the key blank to use DefaultAzureCredential
# (az login / managed identity), which is the recommended path.
DOCUMENTINTELLIGENCE_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
DOCUMENTINTELLIGENCE_API_KEY=

# --- Azure AI Content Understanding (producers: content-understanding, hybrid-cu-di)
# Auth is Entra ID only; the key below is unused by the client.
# Run `goselect-docproc setup-analyzer` once before benching.
# The service rejects '-' in an analyzer id; keep this alphanumeric.
CONTENTUNDERSTANDING_ENDPOINT=https://<resource>.services.ai.azure.com/
CONTENTUNDERSTANDING_API_KEY=
CU_ANALYZER_ID=goselectRouter

# --- Mistral OCR (producer: mistral-blocks) ----------------------------------
# Requires the client library: conda install -c conda-forge mistralai
#
# Option A - first-party API: set MISTRAL_API_KEY only, leave MISTRAL_BASE_URL
#   blank. 170 languages, no 30-page cap, but inference leaves Azure.
# Option B - Azure Foundry: deploy mistral-ocr-4-0 from the model catalogue,
#   then copy Target URI and Key from the deployment's Details tab.
#   Constraints: 30 pages / 30 MB per request, English only, Preview.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Override only if the deployment's Target URI already contains the path.
MISTRAL_OCR_PATH=/v1/ocr

# --- Model layer (extraction) ------------------------------------------------
# Foundry deployment used for chat completions. Falls back to the Content
# Understanding endpoint when blank, because both live on the same AI Services
# resource. Leave the key blank to use DefaultAzureCredential.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Deployments used by eval/report.py. Measured on the Howey package: the mini is
# equal to the flagship on specification prose and fabricated tags on drawings,
# so the two paths are deliberately different deployments.
REPORT_MODEL=gpt-5.4-mini
REPORT_DRAWING_MODEL=gpt-5.6-sol
